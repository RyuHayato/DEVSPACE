{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevWorkspace",
  "version": "1.0.0",
  "identifier": "studio.devworkspace.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "DevWorkspace",
        "width": 1320,
        "height": 860,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0B0C0E",
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:5173 http://localhost:5173; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "DevWorkspace",
    "category": "DeveloperTool",
    "shortDescription": "Your projects. One command center.",
    "longDescription": "DevWorkspace is a local-first developer command center for inspecting, operating and navigating all of your local projects from one place."
  }
}
